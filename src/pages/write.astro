---
import CategoryNav from "../components/CategoryNav.astro";

const categories = [
  { id: "development", name: "개발" },
  { id: "ctf", name: "CTF/Wargame" },
  { id: "bug-bounty", name: "Bug Bounty" },
  { id: "tech-writing", name: "블로그/기술문서" },
  { id: "papers", name: "논문/컨퍼런스" },
  { id: "contests", name: "공모전/자격증" },
];
---

<html lang="ko">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="블로그 글 초안을 작성합니다." />
    <title>글쓰기 | oeon의 블로그</title>
  </head>
  <body>
    <CategoryNav />
    <main class="editor-page">
      <h1>글쓰기</h1>
      <p class="draft-note">작성 내용은 이 페이지를 떠나면 삭제됩니다. 보관하려면 Markdown 파일로 내려받으세요.</p>

      <label for="post-category">카테고리</label>
      <select id="post-category">
        {categories.map((category) => (
          <option value={category.id}>{category.name}</option>
        ))}
      </select>
      <p class="folder-hint">저장할 위치: <code id="category-folder">src/content/posts/development/</code></p>

      <label for="post-title">제목</label>
      <input id="post-title" class="title-input" type="text" placeholder="제목을 입력하세요" />

      <label for="post-slug">글 주소</label>
      <input id="post-slug" type="text" placeholder="예: my-first-post (영문 소문자, 숫자, 하이픈)" />

      <label for="post-description">짧은 설명</label>
      <input id="post-description" type="text" placeholder="글 목록에 표시할 설명" />

      <div class="toolbar" role="toolbar" aria-label="본문 삽입 도구">
        <button id="insert-image" type="button" aria-label="사진 삽입" title="사진 삽입">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="8.5" cy="9" r="1.5" />
            <path d="m21 15-5-5L5 20" />
          </svg>
        </button>
        <button id="insert-file" type="button" aria-label="파일 삽입" title="파일 삽입">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
            <path d="M14 3v6h5M9 14h6M9 18h6" />
          </svg>
        </button>
        <button id="insert-code" type="button" aria-label="코드 삽입" title="코드 삽입">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16" />
          </svg>
        </button>
      </div>
      <p class="asset-note">사진과 파일 버튼은 본문에 링크를 넣습니다. Markdown 파일과 함께 선택한 사진은 <code>public/images/</code>, 첨부파일은 <code>public/files/</code>에 원래 이름 그대로 넣어 주세요.</p>

      <label for="post-body">본문</label>
      <textarea id="post-body" placeholder="본문을 작성하세요. 엔터와 탭도 글에 반영됩니다."></textarea>
      <input id="image-file" type="file" accept="image/*" hidden />
      <input id="attachment-file" type="file" hidden />

      <div class="editor-actions">
        <p id="draft-status" role="status" aria-live="polite">초안을 작성해 보세요.</p>
        <button id="download-draft" type="button">Markdown 내려받기</button>
      </div>
    </main>
  </body>
</html>

<script>
  const categorySelect = document.querySelector('#post-category');
  const titleInput = document.querySelector('#post-title');
  const slugInput = document.querySelector('#post-slug');
  const descriptionInput = document.querySelector('#post-description');
  const folderHint = document.querySelector('#category-folder');
  const bodyInput = document.querySelector('#post-body');
  const status = document.querySelector('#draft-status');
  const imageInput = document.querySelector('#image-file');
  const attachmentInput = document.querySelector('#attachment-file');
  const imageButton = document.querySelector('#insert-image');
  const fileButton = document.querySelector('#insert-file');
  const codeButton = document.querySelector('#insert-code');
  const downloadButton = document.querySelector('#download-draft');

  if (categorySelect instanceof HTMLSelectElement &&
      titleInput instanceof HTMLInputElement &&
      slugInput instanceof HTMLInputElement &&
      descriptionInput instanceof HTMLInputElement &&
      bodyInput instanceof HTMLTextAreaElement) {
    const requestedCategory = new URLSearchParams(location.search).get('category');
    if (requestedCategory && [...categorySelect.options].some((option) => option.value === requestedCategory)) {
      categorySelect.value = requestedCategory;
    }

    let activeCategory = categorySelect.value;
    function updateFolderHint() {
      if (folderHint) folderHint.textContent = 'src/content/posts/' + activeCategory + '/';
    }

    function clearDraft() {
      titleInput.value = '';
      slugInput.value = '';
      descriptionInput.value = '';
      bodyInput.value = '';
    }

    try {
      for (const category of categorySelect.options) {
        localStorage.removeItem('oeon-blog-draft-' + category.value);
      }
    } catch {
      // 저장 공간 접근이 막혀 있어도 글쓰기는 계속 사용할 수 있습니다.
    }
    updateFolderHint();
    window.addEventListener('pagehide', clearDraft);
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) clearDraft();
    });

    function insertText(text) {
      const start = bodyInput.selectionStart;
      const end = bodyInput.selectionEnd;
      bodyInput.setRangeText(text, start, end, 'end');
      bodyInput.focus();
    }

    bodyInput.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && !event.shiftKey) {
        event.preventDefault();
        insertText('\t');
      }
    });

    function preserveTabs(markdown) {
      let insideCode = false;
      return markdown.split('\n').map((line) => {
        if (/^\s*(`{3,}|~{3,})/.test(line)) {
          insideCode = !insideCode;
          return line;
        }
        return insideCode ? line : line.replace(/\t/g, '&#9;');
      }).join('\n');
    }

    categorySelect.addEventListener('change', () => {
      activeCategory = categorySelect.value;
      updateFolderHint();
    });

    imageButton?.addEventListener('click', () => {
      if (imageInput instanceof HTMLInputElement) imageInput.click();
    });
    fileButton?.addEventListener('click', () => {
      if (attachmentInput instanceof HTMLInputElement) attachmentInput.click();
    });
    codeButton?.addEventListener('click', () => {
      const selectedCode = bodyInput.value.slice(bodyInput.selectionStart, bodyInput.selectionEnd);
      const fence = String.fromCharCode(96).repeat(3);
      insertText('\n' + fence + '\n' + (selectedCode || '코드를 입력하세요') + '\n' + fence + '\n');
    });

    imageInput?.addEventListener('change', () => {
      if (!(imageInput instanceof HTMLInputElement)) return;
      const file = imageInput.files?.[0];
      if (!file) return;
      insertText('![' + file.name + '](/images/' + encodeURIComponent(file.name) + ')');
      if (status) status.textContent = '사진 경로를 넣었어요. 파일을 프로젝트의 public/images 폴더에도 복사해 주세요.';
      imageInput.value = '';
    });

    attachmentInput?.addEventListener('change', () => {
      if (!(attachmentInput instanceof HTMLInputElement)) return;
      const file = attachmentInput.files?.[0];
      if (!file) return;
      insertText('[' + file.name + '](/files/' + encodeURIComponent(file.name) + ')');
      if (status) status.textContent = '파일 경로를 넣었어요. 파일을 프로젝트의 public/files 폴더에도 복사해 주세요.';
      attachmentInput.value = '';
    });

    downloadButton?.addEventListener('click', () => {
      const title = titleInput.value.trim() || '제목 없음';
      const slug = slugInput.value.trim();
      if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
        if (status) status.textContent = '글 주소에는 영문 소문자, 숫자, 하이픈을 사용해 주세요.';
        slugInput.focus();
        return;
      }
      const description = descriptionInput.value.trim() || bodyInput.value.replace(/[#*`>\[\]()_-]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 150);
      const localDate = new Date();
      const date = [localDate.getFullYear(), String(localDate.getMonth() + 1).padStart(2, '0'), String(localDate.getDate()).padStart(2, '0')].join('-');
      const markdown = [
        '---',
        'title: ' + JSON.stringify(title),
        'slug: ' + JSON.stringify(slug),
        'category: ' + JSON.stringify(activeCategory),
        'date: ' + JSON.stringify(date),
        'description: ' + JSON.stringify(description),
        '---',
        '',
        preserveTabs(bodyInput.value),
      ].join('\n');
      const url = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = slug + '.md';
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      if (status) status.textContent = '다운로드 완료. src/content/posts/' + activeCategory + '/ 폴더에 넣어 주세요.';
    });
  }
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: #fff;
    color: #202124;
    font-family: system-ui, "Noto Sans KR", sans-serif;
    line-height: 1.6;
  }
  .editor-page {
    width: min(100% - 40px, 900px);
    margin: 0 auto;
    padding: 56px 0 100px;
  }
  h1 { margin: 0 0 8px; font-size: clamp(32px, 6vw, 48px); }
  .draft-note { margin: 0 0 32px; color: #666; font-size: 14px; }
  label { display: block; margin: 24px 0 8px; font-weight: 700; }
  select, .title-input, #post-slug, #post-description, textarea {
    width: 100%;
    border: 1px solid #d8d3e3;
    border-radius: 12px;
    background: #fff;
    color: inherit;
    font: inherit;
  }
  select { max-width: 260px; padding: 10px 12px; }
  .title-input { padding: 16px 18px; font-size: 26px; font-weight: 700; }
  #post-slug, #post-description { padding: 12px 14px; }
  .folder-hint { margin: 8px 0 0; color: #666; font-size: 13px; }
  textarea {
    min-height: 58vh;
    padding: 20px;
    resize: vertical;
    line-height: 1.7;
  }
  select:focus-visible, .title-input:focus-visible, textarea:focus-visible, button:focus-visible {
    outline: 2px solid #543e8b;
    outline-offset: 3px;
  }
  .toolbar { display: flex; gap: 10px; margin-top: 24px; }
  .asset-note { margin: 12px 0 0; color: #666; font-size: 13px; }
  .toolbar button {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid #a486e5;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 0 12px rgb(135 88 232 / 30%);
    color: #543e8b;
    cursor: pointer;
  }
  .toolbar svg { width: 22px; height: 22px; }
  .editor-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
  }
  #draft-status { color: #666; font-size: 13px; }
  #download-draft {
    padding: 12px 18px;
    border: 0;
    border-radius: 10px;
    background: #543e8b;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  @media (max-width: 600px) {
    .editor-actions { align-items: flex-start; flex-direction: column; }
    .title-input { font-size: 21px; }
  }
</style>
