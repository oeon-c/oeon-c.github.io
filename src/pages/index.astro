---
import CategoryNav from "../components/CategoryNav.astro";
import PostSearch from "../components/PostSearch.astro";
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="배운 것과 관심 있는 주제를 기록하는 블로그입니다."
    />
    <title>oeon 블로그</title>
  </head>

  <body>
    <CategoryNav />
    <div class="page">
      <main>
        <section class="intro" aria-labelledby="intro-title">
			<p class="eyebrow">oeon</p>
			<h1 id="intro-title"><span class="accent-text">oeon</span>의 블로그</h1>
			<span class="cheese-icon" aria-hidden="true">🧀</span>
		  </section>

		  <section class="about" id="about" aria-labelledby="about-title">
			<p class="eyebrow">ABOUT</p>
			<h2 id="about-title">안녕하세요, <span class="accent-text">oeon</span>입니다.</h2>
			<p>소속: 이화여자대학교</p>
			<p>전공: 사이버보안/철학</p>
			<p>닉네임: <span class="accent-text">oeon</span></p>
		  </section>

		  <PostSearch />
	  </main>

      <footer class="site-footer">
        <p>© 2026 My Blog</p>
      </footer>
    </div>
  </body>
</html>

<style>
:global(*) {
  box-sizing: border-box;
}

:global(body) {
  margin: 0;
  background: #fff;
  color: #202124;
  font-family: system-ui, "Courier New", monospace;
  line-height: 1.6;
}

:global(a) {
  color: inherit;
}

:global(:root) {
  --accent-purple: #543e8b;
}

.intro .eyebrow {
  color: var(--accent-purple);
}

.accent-text {
  color: var(--accent-purple);
}

.cheese-icon {
  display: block;
  line-height: 1;
  filter: hue-rotate(205deg) saturate(1.5);
}

.cheese-icon {
  margin-top: 90px;
  font-size: 50px;
}

.about .eyebrow {
  color: #777;
}

.page {
  width: min(100% - 40px, 760px);
  margin: 0 auto;
}

.intro {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 80px 0;
}

.intro h1 {
  margin: 0;
  font-size: clamp(36px, 7.5vw, 64px);
  line-height: 1.15;
  letter-spacing: -0.04em;
}

.about {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 0;
}

:global(html) {
  scroll-behavior: smooth;
}

@media (max-width: 520px) {
  .intro,
  .about {
    min-height: 100svh;
    padding: 64px 0;
  }
}
</style>
