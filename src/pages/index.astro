---
import CategoryNav from "../components/CategoryNav.astro";
import PostSearch from "../components/PostSearch.astro";
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="배운 것과 관심 있는 주제를 기록하는 블로그입니다."
    />
    <title>oeon 블로그</title>
  </head>

  <body>
    <CategoryNav />
    <div class="page">
      <main>
        <section class="intro" aria-labelledby="intro-title">
			<div class="hero-heading">
			  <a class="eyebrow writer-link" href="/write/" aria-label="글쓰기 페이지 열기">oeon</a>
			  <h1 id="intro-title"><span class="accent-text">oeon</span>의 블로그</h1>
			  <button class="cheese-trigger" type="button" aria-expanded="false" aria-controls="hero-search" aria-label="게시글 검색 열기">
				<span class="cheese-icon" aria-hidden="true">🧀</span>
				<span class="search-label" aria-hidden="true">Search</span>
			  </button>
			</div>
			<div class="hero-search" id="hero-search" inert>
			  <div class="hero-search-inner">
				<PostSearch compact />
			  </div>
			</div>
		  </section>

		  <section class="about" id="about" aria-labelledby="about-title">
			<p class="eyebrow">ABOUT</p>
			<h2 id="about-title">안녕하세요, <span class="accent-text">oeon</span>입니다.</h2>
			<p>소속: 이화여자대학교</p>
			<p>전공: 사이버보안/철학</p>
			<p>mail: christinakimdoy@gmail.com</p>
			<a
			  class="github-link"
			  href="https://github.com/oeon-c"
			  target="_blank"
			  rel="noopener noreferrer"
			  aria-label="oeon-c의 GitHub 프로필 새 탭에서 열기"
			>
			  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
				<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.23.48-2.69-.95-2.69-.95-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.22.82 1.22.82.71 1.21 1.87.86 2.33.65.07-.51.28-.86.51-1.06-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 4.73c.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
			  </svg>
			  <span>GitHub</span>
			</a>
		  </section>

	  </main>

      <footer class="site-footer">
        <p>© 2026 My Blog</p>
      </footer>
    </div>
  </body>
</html>

<script>
  const intro = document.querySelector(".intro");
  const cheeseTrigger = document.querySelector(".cheese-trigger");
  const heroSearch = document.querySelector("#hero-search");

  if (intro instanceof HTMLElement && cheeseTrigger instanceof HTMLButtonElement && heroSearch instanceof HTMLElement) {
    cheeseTrigger.addEventListener("click", () => {
      const isOpen = intro.classList.toggle("search-open");
      cheeseTrigger.setAttribute("aria-expanded", String(isOpen));
      cheeseTrigger.setAttribute("aria-label", isOpen ? "게시글 검색 닫기" : "게시글 검색 열기");
      heroSearch.inert = !isOpen;

      if (isOpen) {
        window.setTimeout(() => {
          if (intro.classList.contains("search-open")) {
            heroSearch.querySelector("input")?.focus({ preventScroll: true });
          }
        }, window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 400);
      }
    });
  }
</script>

<style>
:global(*) {
  box-sizing: border-box;
}

:global(body) {
  margin: 0;
  background: #fff;
  color: #202124;
  font-family: system-ui, "Courier New", monospace;
  line-height: 1.6;
}

:global(a) {
  color: inherit;
}

:global(:root) {
  --accent-purple: #543e8b;
}

.intro .eyebrow {
  color: var(--accent-purple);
}

.writer-link {
  display: inline-block;
  text-decoration: none;
}

.accent-text {
  color: var(--accent-purple);
}

.cheese-icon {
  display: grid;
  position: absolute;
  inset: 0;
  place-items: center;
  line-height: 1;
  filter: hue-rotate(205deg) saturate(1.5);
  font-size: 50px;
  transition: opacity 220ms ease, transform 220ms ease;
}

.cheese-trigger {
  position: relative;
  width: 156px;
  height: 68px;
  margin-top: 52px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  transition: margin-top 500ms ease;
}

.search-label {
  display: grid;
  position: absolute;
  inset: 0;
  place-items: center;
  border-radius: 999px;
  background: #e5d4ff;
  box-shadow: 0 0 18px rgb(132 91 224 / 75%), 0 0 42px rgb(132 91 224 / 45%);
  color: #111;
  font: inherit;
  font-size: 20px;
  font-weight: 800;
  opacity: 0;
  transform: scale(.85);
  transition: opacity 220ms ease, transform 220ms ease;
}

.cheese-trigger:hover .cheese-icon,
.cheese-trigger:focus-visible .cheese-icon {
  opacity: 0;
  transform: scale(.85);
}

.cheese-trigger:hover .search-label,
.cheese-trigger:focus-visible .search-label {
  opacity: 1;
  transform: scale(1);
}

.cheese-trigger:focus-visible {
  outline: 2px solid var(--accent-purple);
  outline-offset: 6px;
  border-radius: 8px;
}

.about .eyebrow {
  color: #777;
}

.github-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  margin-top: 14px;
  color: #202124;
  font-weight: 600;
  text-decoration: none;
}

.github-link svg {
  width: 28px;
  height: 28px;
}

.github-link:hover,
.github-link:focus-visible {
  color: var(--accent-purple);
}

.page {
  width: min(100% - 40px, 760px);
  margin: 0 auto;
}

.intro {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 80px 0;
}

.hero-heading {
  transition: transform 500ms ease;
}

.hero-search {
  display: grid;
  grid-template-rows: 0fr;
  width: 100%;
  opacity: 0;
  transform: translateY(24px);
  transition: grid-template-rows 500ms ease, opacity 400ms ease, transform 500ms ease;
}

.hero-search-inner {
  min-height: 0;
  overflow: hidden;
}

.intro.search-open .hero-heading {
  transform: translateY(-24px);
}

.intro.search-open .cheese-trigger {
  margin-top: 28px;
}

.intro.search-open .hero-search {
  grid-template-rows: 1fr;
  opacity: 1;
  transform: translateY(0);
}

.intro h1 {
  margin: 0;
  font-size: clamp(36px, 7.5vw, 64px);
  line-height: 1.15;
  letter-spacing: -0.04em;
}

.about {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px 0;
}

:global(html) {
  scroll-behavior: smooth;
}

@media (max-width: 520px) {
  .intro,
  .about {
    min-height: 100svh;
    padding: 64px 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-heading,
  .cheese-trigger,
  .hero-search {
    transition: none;
  }
  .cheese-icon,
  .search-label {
    transition: none;
  }
}
</style>
