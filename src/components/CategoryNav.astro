---
const categories = [
  { name: "홈", href: "/", home: true },
  { name: "개발", href: "/development/" },
  { name: "CTF/Wargame", href: "/ctf/" },
  { name: "Bug Bounty", href: "/bug-bounty/" },
  { name: "블로그/기술문서", href: "/tech-writing/" },
  { name: "논문/컨퍼런스", href: "/papers/" },
  { name: "공모전/자격증", href: "/contests/" },
];
---

<header id="top" class="site-header">
  <nav aria-label="블로그 메뉴">
    {categories.map((category) => (
      <a
        href={category.href}
        aria-label={category.name}
        class:list={{ "home-link": category.home }}
      >
        <span
          class:list={[
            "category-cheese",
            { "large-cheese": category.home },
          ]}
          aria-hidden="true"
        >🧀</span>
        <span class="category-name">{category.name}</span>
      </a>
    ))}
  </nav>
</header>
<a class="back-to-top" href="#top">맨 위로 ↑</a>

<style>
  :global(:root) {
    --accent-purple: #543e8b;
  }

  .site-header {
    min-height: 76px;
    padding: 8px 24px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    border-bottom: 1px solid #c8c8c8;
  }

  nav {
    width: min(100%, 1200px);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }

  nav a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 34px;
    text-decoration: none;
  }

  .home-link {
    min-width: 52px;
    min-height: 52px;
  }

  .category-cheese {
    display: block;
    font-size: 30px;
    line-height: 1;
    filter: hue-rotate(205deg) saturate(1.5);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .large-cheese {
    font-size: 48px;
  }

  .back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 20;
    color: #555;
    text-decoration: none;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--accent-purple);
  }

  .category-name {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 10;
    padding: 4px 8px;
    border-radius: 6px;
    background: #fff;
    color: var(--accent-purple);
    font-size: 13px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -50%);
    transition: opacity 160ms ease, visibility 160ms;
  }

  nav a:hover .category-name,
  nav a:focus-visible .category-name {
    opacity: 1;
    visibility: visible;
  }

  nav a:hover .category-cheese,
  nav a:focus-visible .category-cheese {
    opacity: 0;
    transform: scale(0.7);
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  @media (max-width: 600px) {
    .site-header {
      padding: 8px 16px;
    }

    nav {
      justify-content: center;
      gap: 12px 20px;
    }
  }
</style>
