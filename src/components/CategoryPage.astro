---
import CategoryNav from "./CategoryNav.astro";
import { getCollection } from "astro:content";

const { categoryId, title } = Astro.props;
const categoryPosts = (await getCollection("posts", ({ data }) => data.category === categoryId))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const previewText = (post) =>
  post.data.description ?? post.body.replace(/[#*`>\[\]()_-]/g, " ").replace(/\s+/g, " ").trim();
---

<html lang="ko">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${title} 카테고리의 글 목록입니다.`} />
    <title>{title} | oeon의 블로그</title>
  </head>
  <body>
    <CategoryNav />
    <main class="category-page">
      <div class="page-heading">
        <div>
          <p class="eyebrow">CATEGORY</p>
          <h1>{title}</h1>
        </div>
      </div>

      {categoryPosts.length > 0 ? (
        <div class="post-list">
          {categoryPosts.map((post) => (
            <article class="post-card" id={`post-${post.data.slug}`}>
              <a href={`/${post.data.slug}/`}>
                {post.data.isSample && <span class="sample-label">테스트 게시글</span>}
                <h2>{post.data.title}</h2>
                <p class="post-preview">{previewText(post)}</p>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-message">아직 게시글이 없습니다.</p>
      )}
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fff;
    color: #202124;
    font-family: system-ui, "Noto Sans KR", sans-serif;
    line-height: 1.6;
  }

  :global(:root) {
    --accent-purple: #543e8b;
  }

  .category-page {
    width: min(100% - 40px, 760px);
    min-height: calc(100vh - 76px);
    margin: 0 auto;
    padding: 72px 0 100px;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--accent-purple);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  h1 {
    margin: 0 0 32px;
    font-size: clamp(32px, 6vw, 48px);
    line-height: 1.2;
  }

  .post-list {
    border-top: 1px solid #e9e7ee;
  }

  .post-card {
    padding: 22px 0;
    border-bottom: 1px solid #e9e7ee;
    scroll-margin-top: 28px;
  }

  .post-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-card a:hover h2,
  .post-card a:focus-visible h2 {
    color: var(--accent-purple);
  }

  .sample-label {
    color: var(--accent-purple);
    font-size: 11px;
    font-weight: 700;
  }

  h2 {
    margin: 4px 0 6px;
    font-size: 18px;
  }

  .post-preview {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #666;
    font-size: 14px;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .empty-message {
    color: #666;
  }

  @media (max-width: 520px) {
    .category-page {
      padding-top: 48px;
    }
  }
</style>
