---
import CategoryNav from "./CategoryNav.astro";
import { getCollection } from "astro:content";
import "../styles/fonts.css";

const { categoryId, title, page = 1 } = Astro.props;
const categoryPosts = (await getCollection("posts", ({ data }) => data.category === categoryId))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.slug.localeCompare(a.data.slug));
const pageSize = 16;
const pageCount = Math.ceil(categoryPosts.length / pageSize);
const visiblePosts = categoryPosts.slice((page - 1) * pageSize, page * pageSize);
const pageUrl = (number) => number === 1 ? `/${categoryId}/` : `/${categoryId}/${number}/`;

const formatDate = (date) => date.toISOString().slice(2, 10).replaceAll("-", ".");

---

<html lang="ko">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${title} 카테고리의 글 목록입니다.`} />
    <title>{title} | oeon의 블로그</title>
  </head>
  <body>
    <CategoryNav />
    <main class="category-page">
      <div class="page-heading">
        <h1>{title}</h1>
      </div>

      {visiblePosts.length > 0 ? (
        <div class="post-list">
          {visiblePosts.map((post) => (
            <article class="post-card" id={`post-${post.data.slug}`}>
              <a href={`/${post.data.slug}/`}>
                <span class="document-icon" aria-hidden="true">
                  <svg viewBox="0 0 72 88" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 3h34l20 20v58a4 4 0 0 1-4 4H11a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z" fill="#E9E2F2" />
                    <path d="M45 3v16a4 4 0 0 0 4 4h16L45 3Z" fill="#CFC3DE" />
                    <path d="M19 43h34M19 53h34M19 63h25" stroke="#9D8DAB" stroke-width="3" stroke-linecap="round" />
                  </svg>
                </span>
                <span class="file-name">{post.data.title}_<time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time></span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-message">아직 게시글이 없습니다.</p>
      )}
      {pageCount > 1 && (
        <nav class="pagination" aria-label="글 목록 페이지">
          {page > 1 && <a href={pageUrl(page - 1)} aria-label="이전 페이지">← 이전</a>}
          {Array.from({ length: pageCount }, (_, index) => index + 1).map((number) => (
            <a href={pageUrl(number)} aria-label={`${number}페이지`} aria-current={number === page ? "page" : undefined}>{number}</a>
          ))}
          {page < pageCount && <a href={pageUrl(page + 1)} aria-label="다음 페이지">다음 →</a>}
        </nav>
      )}
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fff;
    color: #202124;
    font-family: "YUniverse", system-ui, sans-serif;
    font-weight: 300;
    line-height: 1.6;
  }

  :global(:root) {
    --accent-purple: #543e8b;
  }

  .category-page {
    width: min(100% - 40px, 1040px);
    min-height: calc(100vh - 76px);
    margin: 0 auto;
    padding: 20px 0 100px;
  }

  .page-heading {
    margin-bottom: 38px;
  }

  h1 {
    margin: 0;
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.2;
  }

  .post-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px 16px;
  }

  .post-card {
    min-width: 0;
    scroll-margin-top: 28px;
  }

  .post-card a {
    display: flex;
    min-height: 160px;
    flex-direction: column;
    align-items: center;
    padding: 10px;
    color: inherit;
    text-decoration: none;
  }

  .document-icon {
    display: grid;
    position: relative;
    width: 96px;
    height: 104px;
    place-items: center;
    isolation: isolate;
  }

  .document-icon::before {
    position: absolute;
    inset: 15px 4px;
    z-index: -1;
    border-radius: 50%;
    background: #a474f3;
    content: "";
    filter: blur(22px);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .document-icon svg {
    width: 72px;
    height: 88px;
    transition: transform 220ms ease;
  }

  .post-card a:hover .document-icon::before,
  .post-card a:focus-visible .document-icon::before {
    opacity: .8;
  }

  .post-card a:hover .document-icon svg,
  .post-card a:focus-visible .document-icon svg {
    transform: scale(1.09);
  }

  .post-card a:focus-visible {
    outline: 2px solid var(--accent-purple);
    outline-offset: 2px;
    border-radius: 12px;
  }

  .file-name {
    max-width: 100%;
    color: #202124;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .pagination {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 56px;
  }

  .pagination a {
    min-width: 36px;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--accent-purple);
    text-align: center;
    text-decoration: none;
  }

  .pagination a:hover,
  .pagination a:focus-visible,
  .pagination a[aria-current="page"] {
    background: #eee7fa;
  }

  .empty-message {
    color: #666;
  }

  @media (max-width: 700px) {
    .post-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .document-icon::before,
    .document-icon svg { transition: none; }
  }
</style>
